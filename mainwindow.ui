          <property name="styleSheet">
           <string notr="true">QPushButton {
    background-color: #008000;  /* Couleur de fond verte */
    color: #FFFFFF;             /* Texte blanc */
    font-weight: bold;          /* Texte en gras */
    font-size: 18px;            /* Taille de police 16px dès le départ */
    border-radius: 5px;         /* Coins arrondis */
    padding: 5px 10px;          /* Espacement interne du bouton */
    border: none;               /* Pas de bordure */
}

QPushButton:hover {
    background-color: #006400;  /* Couleur de fond plus foncée au survol */
    color: white;               /* Texte toujours blanc */
    border-radius: 10px;        /* Coins arrondis plus marqués au survol */
    font-weight: bold;          /* Texte en gras (encore) */
    border: none;               /* Pas de bordure au survol */
}
</string>
