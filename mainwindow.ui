          <property name="styleSheet">
           <string notr="true">QPushButton {
    background-color: #007FFF;  /* Couleur de fond bleue */
    color: #FFFFFF;             /* Texte blanc */
    font-size: 18px;            /* Augmentation de la taille de la police */
    font-weight: bold;          /* Texte en gras */
    border-radius: 5px;         /* Coins arrondis avec un rayon de 5px */
    padding: 5px 10px;          /* Espacement interne du bouton (haut/bas : 5px, gauche/droite : 10px) */
    border: none;               /* Pas de bordure */
}

QPushButton:hover {
    background-color: #005BB5;  /* Couleur de fond plus foncée au survol */
    color: #FFFFFF;             /* Texte toujours blanc */

    border-radius: 10px;        /* Coins arrondis plus marqués au survol */
    padding: 7px 12px;          /* Augmentation du padding au survol */
    border: none;               /* Pas de bordure au survol */
}
</string>
