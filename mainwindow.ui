        <property name="styleSheet">
         <string notr="true">QTableWidget {
    border: 1px solid #B0B0B0; /* Light gray border */
    gridline-color: #D3D3D3; /* Gridline color */
    background-color: #FFFFFF; /* White background */
    alternate-background-color: #F5F5F5; /* Alternate row color */
    font-size: 14px; /* Font size */
}

QTableWidget::item {
    padding: 10px; /* Padding for table cells */
}

QTableWidget::item:selected {
    background-color: #FFCCCC; /* Light red background when selected */
    color: #8B0000; /* Dark red text color */
}

QHeaderView::section {
    background-color: #8B0000; /* Dark red for header background */
    color: white; /* White text */
    font-weight: bold; /* Bold font for headers */
    padding: 5px; /* Padding inside headers */
    border: 1px solid #FFFFFF; /* White border between header cells */
}

QTableCornerButton::section {
    background-color: #8B0000; /* Dark red for the top-left corner */
    border: 1px solid white; /* White border */
}

QScrollBar:vertical {
    border: none;
    background: #F0F0F0; /* Light gray background */
    width: 10px;
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:vertical {
    background: #8B0000; /* Dark red handle */
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #FF4500; /* Lighter red when hovered */
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}</string>
